# Installed to ~/.config/systemd/user/ and enabled by `mise run server:unit` (@ROOT@ is this repo).
# Starts at login, so Ferb Link works after a restart; the router loads the model only on the
# first request, so it costs almost nothing idle. Models run one at a time, through Ferb's bench
# lock (run.sh): while the bench runs, run.sh exits 75 and the unit tries again every 30 s, so the
# server comes back by itself once the bench ends. Any other failure to start (no model, no key, a
# bad setting: exit 1) isn't retried; `mise run server:start` shows why.
[Unit]
Description=llama-server for Ferb (ferb-link)
# No start limit: the 30 s wait is the limit, and a bench can take an hour.
StartLimitIntervalSec=0

[Service]
ExecStart=@ROOT@/server/run.sh
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=1

[Install]
WantedBy=default.target
