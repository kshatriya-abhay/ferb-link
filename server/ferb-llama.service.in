# Installed to ~/.config/systemd/user/ by `mise run server:install` (@ROOT@ is this repo).
# Not enabled at login: start it with `mise run server:start`, so it never runs during a bench.
[Unit]
Description=llama-server for Ferb (ferb-link)
# Give up after 3 failed starts in a minute (e.g. no model set) instead of retrying forever.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=@ROOT@/server/run.sh
Restart=on-failure
RestartSec=5
