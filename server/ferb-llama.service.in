# Installed to ~/.config/systemd/user/ and enabled by `mise run server:unit` (@ROOT@ is this repo).
# Starts at login, so Ferb Link works after a restart; the router loads the model only on the
# first request, so it costs almost nothing idle. Ferb's bench refuses to run while it's active:
# `mise run server:stop` first (models run one at a time).
[Unit]
Description=llama-server for Ferb (ferb-link)
# Give up after 3 failed starts in a minute (e.g. no model set) instead of retrying forever.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
ExecStart=@ROOT@/server/run.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
