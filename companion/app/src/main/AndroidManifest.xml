<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The one thing Ferb must never have: Ferb Link talks to the laptop's model server over
         Tailscale, so Ferb itself stays offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FerbLink">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pairing links (Pairing.kt): `mise run server:pair`'s QR code or `companion:pair`.
                 They only offer: the user confirms the computer's name before anything is saved. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ferblink" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- Ferb's way in (LinkContract): exported, but LinkProvider only answers apps signed
             with this app's key. -->
        <provider
            android:name=".LinkProvider"
            android:authorities="dev.abhay.ferblink.link"
            android:exported="true" />
    </application>
</manifest>
